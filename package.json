{
  "name": "schema-lens",
  "version": "1.0.0",
  "description": "DBML 스키마를 전체 ERD와 1-테이블 포커스 모드로 탐색하는 데스크톱 앱",
  "main": "out/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node out/scripts/check-model.js",
    "test:contrast": "npm run build && node out/scripts/check-contrast.js",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "keywords": [],
  "author": "HwangBBang",
  "license": "MIT",
  "repository": "github:HwangBBang/schema-lens",
  "type": "commonjs",
  "build": {
    "appId": "io.github.hwangbbang.schema-lens",
    "productName": "schema-lens",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/main.js",
      "out/preload.js",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/bundle.js",
      "assets/example.dbml"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "publish": {
      "provider": "github"
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@dbml/core": "^8.3.1-custom-metadata.3",
    "elkjs": "^0.12.0"
  }
}
